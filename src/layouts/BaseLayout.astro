---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import { url } from '../utils/base';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  publicationDate?: Date | string;
  authorName?: string;
  searchItems?: Array<{
    title: string;
    slug: string;
    description: string;
    category: string;
    caseId?: string;
    tags?: string[];
  }>;
}

const {
  title = "CYBER EXORCIST | Exposing the Anatomy of Digital Crime",
  description = "Independent Cybercrime Research & Technical Investigation Publication. Deconstructing threat actors, exploits, darknet operations, and digital forensic evidence.",
  image = "/og-image.svg",
  article = false,
  publicationDate,
  authorName,
  searchItems = []
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://cyberexorcist.publication';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const fullImageUrl = new URL(url(image), siteUrl).toString();

// Base Schema.org structured data
const siteSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": siteUrl,
      "name": "Cyber Exorcist",
      "description": "Independent Cybercrime Research & Technical Investigation Publication",
      "publisher": {
        "@id": `${siteUrl}/#organization`
      }
    },
    {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      "name": "Cyber Exorcist",
      "url": siteUrl,
      "logo": {
        "@type": "ImageObject",
        "url": `${siteUrl}${url('/favicon.svg')}`
      },
      "sameAs": [
        "https://github.com/Cyber-Exorcist0",
        "https://www.linkedin.com/in/cyber-exorcist0/"
      ]
    }
  ]
};
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title="Cyber Exorcist Case Files RSS" href={url('/rss.xml')} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageUrl} />
    <meta property="og:site_name" content="Cyber Exorcist" />

    {article && publicationDate && (
      <meta property="article:published_time" content={new Date(publicationDate).toISOString()} />
    )}
    {article && authorName && (
      <meta property="article:author" content={authorName} />
    )}

    <!-- Twitter / X -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={fullImageUrl} />

    <!-- Schema.org Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />

    <!-- Preconnect Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class="bg-exo-bg text-exo-text min-h-screen flex flex-col selection:bg-exo-primary/30 selection:text-exo-primary">
    <Header searchItems={searchItems} />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
    <BackToTop />
  </body>
</html>
