---
import Logo from './icons/Logo.astro';
import { url } from '../utils/base';

const categories = [
  'Cybercrime Investigations',
  'Malware Analysis',
  'Darknet & Underground Markets',
  'Cryptocurrency Crimes',
  'Exploitation & Vulnerabilities',
  'Digital Forensics & Incident Response',
  'Advanced Persistent Threats',
  'Social Engineering & Insider Threats'
];
---

<footer class="bg-exo-secondary border-t border-exo-border mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 lg:gap-12">
      <!-- Col 1: Identity -->
      <div class="lg:col-span-2 space-y-4">
        <Logo variant="full" size="md" />
        <p class="text-xs font-mono text-exo-primary tracking-wide">
          Exposing the Anatomy of Digital Crime.
        </p>
        <p class="text-sm text-slate-400 leading-relaxed max-w-sm">
          A personal informative blog authored by a Computer Engineer exploring cybersecurity, digital forensics, and cybercrime research—dissecting vulnerabilities, exploit chains, and digital evidence.
        </p>
        <div class="pt-2 flex items-center gap-3 font-mono text-xs text-slate-400">
          <span class="inline-flex items-center gap-1.5 px-2 py-1 rounded bg-exo-card border border-exo-border">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            COMPUTER_ENGINEERING
          </span>
          <span class="inline-flex items-center gap-1.5 px-2 py-1 rounded bg-exo-card border border-exo-border">
            DFIR_STUDIES
          </span>
        </div>
      </div>

      <!-- Col 2: Research Categories -->
      <div class="space-y-3">
        <h4 class="font-mono text-xs uppercase tracking-widest text-slate-200 font-bold">
          Research Sectors
        </h4>
        <ul class="space-y-2 text-xs font-mono text-slate-400 list-none p-0 m-0">
          {categories.slice(0, 5).map((cat) => (
            <li>
              <a
                href={url(`/investigations?category=${encodeURIComponent(cat)}`)}
                class="hover:text-exo-primary transition-colors block py-0.5"
              >
                {cat}
              </a>
            </li>
          ))}
          <li>
            <a
              href={url('/investigations')}
              class="text-exo-primary hover:underline block pt-1"
            >
              View all 8 sectors &rarr;
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Editorial & Authors -->
      <div class="space-y-3">
        <h4 class="font-mono text-xs uppercase tracking-widest text-slate-200 font-bold">
          Dossiers &amp; Author
        </h4>
        <ul class="space-y-2 text-xs font-mono text-slate-400 list-none p-0 m-0">
          <li>
            <a href={url('/investigations')} class="hover:text-exo-primary transition-colors">
              Case Files Archive
            </a>
          </li>
          <li>
            <a href={url('/technical-analysis')} class="hover:text-exo-primary transition-colors">
              Technical Analysis Section
            </a>
          </li>
          <li>
            <a href={url('/authors/cyber-exorcist')} class="hover:text-exo-primary transition-colors">
              Cyber Exorcist (Lead Author)
            </a>
          </li>
          <li>
            <a href="https://github.com/Cyber-Exorcist0" target="_blank" rel="noopener noreferrer" class="hover:text-exo-primary transition-colors flex items-center gap-1.5">
              <span>GitHub</span>
              <svg class="w-3 h-3 text-exo-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3" />
              </svg>
            </a>
          </li>
          <li>
            <a href="https://www.linkedin.com/in/cyber-exorcist0/" target="_blank" rel="noopener noreferrer" class="hover:text-exo-primary transition-colors flex items-center gap-1.5">
              <span>LinkedIn</span>
              <svg class="w-3 h-3 text-exo-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3" />
              </svg>
            </a>
          </li>
          <li>
            <a href={url('/about')} class="hover:text-exo-primary transition-colors">
              Editorial Philosophy
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Feeds & Disclosures -->
      <div class="space-y-3">
        <h4 class="font-mono text-xs uppercase tracking-widest text-slate-200 font-bold">
          Transparency &amp; Feeds
        </h4>
        <ul class="space-y-2 text-xs font-mono text-slate-400 list-none p-0 m-0">
          <li>
            <a href={url('/rss.xml')} class="hover:text-exo-primary inline-flex items-center gap-1.5 transition-colors">
              <svg class="w-3.5 h-3.5 text-exo-warning" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16M5 20a1 1 0 1 0 0-2 1 1 0 0 0 0 2z" />
              </svg>
              RSS Case Feed
            </a>
          </li>
          <li>
            <a href={url('/about#methodology')} class="hover:text-exo-primary transition-colors">
              Verification Standards
            </a>
          </li>
          <li>
            <a href="https://github.com/Cyber-Exorcist0" target="_blank" rel="noopener noreferrer" class="hover:text-exo-primary transition-colors flex items-center gap-1">
              <span>Submit Telemetry (GitHub)</span>
              <svg class="w-3 h-3 text-exo-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3" />
              </svg>
            </a>
          </li>
          <li>
            <a href="https://www.linkedin.com/in/cyber-exorcist0/" target="_blank" rel="noopener noreferrer" class="hover:text-exo-primary transition-colors flex items-center gap-1">
              <span>Connect on LinkedIn</span>
              <svg class="w-3 h-3 text-exo-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3" />
              </svg>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Editorial Disclaimer & Copyright -->
    <div class="mt-12 pt-8 border-t border-exo-border/80 flex flex-col md:flex-row items-center justify-between gap-4 text-xs font-mono text-slate-400">
      <p class="max-w-2xl text-center md:text-left text-slate-400 leading-normal">
        Cyber Exorcist publishes technical cybercrime research, forensic case reconstructions, and reverse-engineering insights strictly for defensive education, incident response enhancement, and investigative transparency.
      </p>
      <div class="flex items-center gap-4 flex-shrink-0">
        <span>&copy; {new Date().getFullYear()} CYBER EXORCIST</span>
        <span>•</span>
        <span class="text-exo-primary">OPEN_RESEARCH</span>
      </div>
    </div>
  </div>
</footer>
