---
import Logo from './icons/Logo.astro';
import SearchModal from './SearchModal.astro';
import { url } from '../utils/base';

interface Props {
  searchItems?: Array<{
    title: string;
    slug: string;
    description: string;
    category: string;
    caseId?: string;
    tags?: string[];
  }>;
}

const { searchItems = [] } = Astro.props;
const currentPath = Astro.url.pathname;

const navLinks = [
  { name: 'Case Files', path: '/investigations' },
  { name: 'Technical Analysis', path: '/technical-analysis' },
  { name: 'About Publication', path: '/about' }
];
---

<header class="sticky top-0 z-40 w-full bg-exo-bg/90 backdrop-blur-md border-b border-exo-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand Identity -->
    <a href={url('/')} class="focus:outline-none focus:ring-1 focus:ring-exo-primary rounded">
      <Logo variant="full" size="sm" />
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden lg:flex items-center gap-1 font-mono text-xs">
      {navLinks.map((link) => {
        const linkHref = url(link.path);
        const isActive = currentPath === linkHref || (link.path !== '/' && currentPath.startsWith(linkHref));
        return (
          <a
            href={linkHref}
            class={`px-3 py-1.5 rounded transition-colors ${
              isActive
                ? 'text-exo-primary bg-exo-secondary border border-exo-border'
                : 'text-slate-300 hover:text-white hover:bg-exo-secondary/50'
            }`}
          >
            {link.name}
          </a>
        );
      })}
    </nav>

    <!-- Right Actions: Search & Mobile Menu Button -->
    <div class="flex items-center gap-3">
      <SearchModal items={searchItems} />

      <!-- Mobile Hamburger Toggle -->
      <button
        type="button"
        id="mobile-nav-toggle"
        class="lg:hidden p-2 rounded-md text-slate-300 hover:text-white hover:bg-exo-secondary border border-exo-border focus:outline-none"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
      >
        <svg id="hamburger-icon" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
        <svg id="close-icon" class="w-5 h-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-menu" class="lg:hidden hidden border-b border-exo-border bg-exo-secondary/95 px-4 pt-3 pb-6 space-y-2">
    {navLinks.map((link) => (
      <a
        href={url(link.path)}
        class="block px-3 py-2.5 rounded-md font-mono text-sm text-slate-200 hover:text-exo-primary hover:bg-exo-card border border-transparent hover:border-exo-border transition-colors"
      >
        {link.name}
      </a>
    ))}
    <div class="pt-4 border-t border-exo-border flex items-center justify-between font-mono text-xs text-exo-muted">
      <span>CYBER_EXORCIST // ARCHIVE</span>
      <span class="text-exo-primary">EN // STATIC</span>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-nav-toggle');
  const menu = document.getElementById('mobile-menu');
  const hamburger = document.getElementById('hamburger-icon');
  const close = document.getElementById('close-icon');

  toggleBtn?.addEventListener('click', () => {
    const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
    toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
    menu?.classList.toggle('hidden');
    hamburger?.classList.toggle('hidden');
    close?.classList.toggle('hidden');
  });
</script>
