---
interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "Receive Direct Investigation Dispatches",
  subtitle = "No marketing fluff. In-depth technical dossiers, incident timelines, and reverse-engineering findings delivered when an investigation concludes."
} = Astro.props;
---

<div class="my-12 p-8 md:p-10 rounded-xl bg-gradient-to-b from-exo-card to-exo-secondary border border-exo-border relative overflow-hidden">
  <div class="absolute top-0 right-0 transform translate-x-8 -translate-y-8 w-64 h-64 bg-exo-primary/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-2xl relative z-10">
    <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded bg-exo-secondary border border-exo-border text-[11px] font-mono text-exo-primary mb-3">
      <span class="w-1.5 h-1.5 rounded-full bg-exo-primary"></span>
      INTELLIGENCE_DISPATCH // BI-WEEKLY
    </div>

    <h3 class="text-xl md:text-2xl font-bold text-white mb-2 leading-snug">
      {title}
    </h3>

    <p class="text-sm text-slate-300 mb-6 leading-relaxed">
      {subtitle}
    </p>

    <!-- Integration-Ready Form -->
    <form
      id="newsletter-form"
      class="flex flex-col sm:flex-row gap-3"
      onsubmit="event.preventDefault(); document.getElementById('newsletter-status').classList.remove('hidden');"
    >
      <div class="relative flex-1">
        <input
          type="email"
          id="newsletter-email"
          required
          placeholder="researcher@organization.org"
          class="w-full px-4 py-3 rounded-lg bg-exo-bg border border-exo-border text-slate-200 placeholder-slate-400 font-mono text-xs focus:outline-none focus:border-exo-primary transition-colors"
        />
      </div>

      <button
        type="submit"
        class="px-6 py-3 rounded-lg bg-exo-primary hover:bg-sky-400 text-slate-950 font-mono text-xs font-bold transition-all flex items-center justify-center gap-2 shadow-lg shadow-cyan-950/30"
      >
        <span>SUBSCRIBE</span>
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </button>
    </form>

    <!-- Transparent Integration-Ready Note (Zero fake backend deception) -->
    <div id="newsletter-status" class="hidden mt-4 p-3 rounded-md bg-exo-bg/80 border border-exo-primary/40 text-xs font-mono text-exo-primary">
      ✓ Frontend integration validated. Connect your mailing provider endpoint (Buttondown, Substack, Mailchimp, or AWS SES) in <code>src/components/NewsletterBox.astro</code>.
    </div>

    <p class="mt-3 text-[11px] font-mono text-slate-400">
      * Zero tracking scripts. Unsubscribe at any point. PGP-signed dispatches available upon request.
    </p>
  </div>
</div>
