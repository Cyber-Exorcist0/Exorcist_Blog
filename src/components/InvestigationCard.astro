---
import CategoryBadge from './CategoryBadge.astro';
import { url, formatDate } from '../utils/base';

interface Props {
  title: string;
  slug: string;
  description: string;
  category: string;
  publicationDate: Date | string;
  readingTime: string;
  coverImage: string;
  authors: string[];
  caseId?: string;
  featured?: boolean;
  type?: 'investigation' | 'technical';
}

const {
  title,
  slug,
  description,
  category,
  publicationDate,
  readingTime,
  coverImage,
  authors,
  caseId,
  featured = false,
  type = 'investigation'
} = Astro.props;

// Determine clean article target url
const articleUrl = url(`/investigations/${slug}`);
---

<article
  class={`group relative flex flex-col rounded-lg bg-exo-card border border-exo-border hover:border-exo-primary/60 transition-all duration-300 overflow-hidden shadow-lg hover:shadow-cyan-950/20 ${featured ? 'md:grid md:grid-cols-12 md:gap-6' : ''}`}
>
  <!-- Card Visual Media -->
  <div class={`relative overflow-hidden bg-exo-secondary ${featured ? 'md:col-span-7 h-64 md:h-full min-h-[280px]' : 'h-52 w-full'}`}>
    <a href={articleUrl} class="block w-full h-full">
      <img
        src={url(coverImage)}
        alt={`Cover graphic for ${title}`}
        loading="lazy"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-90 group-hover:opacity-100"
      />
    </a>

    <!-- Top overlay markers -->
    <div class="absolute top-3 left-3 flex flex-wrap items-center gap-2">
      <CategoryBadge category={category} size="sm" />
      {caseId && (
        <span class="font-mono text-[10px] font-bold px-2 py-0.5 rounded bg-black/70 border border-slate-700 text-slate-300 backdrop-blur-sm">
          {caseId}
        </span>
      )}
    </div>

    {type === 'technical' && (
      <div class="absolute top-3 right-3 font-mono text-[10px] uppercase font-bold px-2 py-0.5 rounded bg-purple-950/80 border border-purple-500/50 text-purple-300 backdrop-blur-sm">
        TECHNICAL DEEP DIVE
      </div>
    )}
  </div>

  <!-- Content Section -->
  <div class={`p-5 md:p-6 flex flex-col justify-between flex-1 ${featured ? 'md:col-span-5' : ''}`}>
    <div>
      <!-- Metadata Row -->
      <div class="flex items-center gap-3 text-xs font-mono text-exo-muted mb-2">
        <time datetime={new Date(publicationDate).toISOString()}>
          {formatDate(publicationDate)}
        </time>
        <span>•</span>
        <span>{readingTime}</span>
      </div>

      <!-- Title -->
      <h3 class={`font-bold text-white group-hover:text-exo-primary transition-colors leading-snug mb-3 ${featured ? 'text-xl md:text-2xl' : 'text-lg'}`}>
        <a href={articleUrl}>
          {title}
        </a>
      </h3>

      <!-- Excerpt -->
      <p class="text-slate-300 text-sm leading-relaxed mb-4 line-clamp-3">
        {description}
      </p>
    </div>

    <!-- Bottom Footer Row -->
    <div class="pt-4 border-t border-exo-border/70 flex items-center justify-between text-xs font-mono">
      <div class="flex items-center gap-2 text-slate-300">
        <span class="text-exo-muted">BY:</span>
        <span class="text-slate-200 font-semibold">{authors.join(' & ')}</span>
      </div>

      <a
        href={articleUrl}
        class="inline-flex items-center gap-1 text-exo-primary font-semibold hover:translate-x-0.5 transition-transform"
        aria-label={`Open investigation: ${title}`}
      >
        <span>ACCESS FILE</span>
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </article>
</div>
