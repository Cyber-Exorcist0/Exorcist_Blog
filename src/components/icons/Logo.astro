---
import { url } from '../../utils/base';

interface Props {
  variant?: 'full' | 'compact' | 'icon';
  size?: 'sm' | 'md' | 'lg';
  className?: string;
}

const { variant = 'full', size = 'md', className = '' } = Astro.props;

const dimensions = {
  sm: { icon: 'w-7 h-7', text: 'text-base', sub: 'text-[9px]' },
  md: { icon: 'w-9 h-9', text: 'text-xl', sub: 'text-[10px]' },
  lg: { icon: 'w-12 h-12', text: 'text-2xl', sub: 'text-xs' },
}[size];
---

<div class={`inline-flex items-center gap-3 ${className}`}>
  <!-- Cyber Exorcist Brand Icon -->
  <div class={`relative flex-shrink-0 ${dimensions.icon}`}>
    <img
      src={url('/favicon.png')}
      alt="Cyber Exorcist"
      class="w-full h-full rounded-lg object-cover drop-shadow-[0_0_8px_rgba(56,189,248,0.4)]"
      width="48"
      height="48"
    />
  </div>

  {variant !== 'icon' && (
    <div class="flex flex-col">
      <div class="flex items-center gap-1.5 font-mono font-bold tracking-wider text-slate-100 uppercase leading-none">
        <span class="text-white">CYBER</span>
        <span class="text-exo-primary">EXORCIST</span>
      </div>
      {variant === 'full' && (
        <span class="font-mono text-exo-muted tracking-widest text-[9px] uppercase mt-1">
          Technical Publication
        </span>
      )}
    </div>
  )}
</div>
