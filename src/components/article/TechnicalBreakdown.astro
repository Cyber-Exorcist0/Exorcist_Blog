---
interface Props {
  title: string;
  topic?: string;
  complexity?: 'Fundamental' | 'Intermediate' | 'Deep Forensic' | 'Binary Internals';
}

const { title, topic = "VULNERABILITY & EXECUTION MECHANICS", complexity = "Deep Forensic" } = Astro.props;
---

<div class="my-10 rounded-lg border-2 border-exo-primary/30 bg-[#070A10] overflow-hidden shadow-2xl">
  <!-- Terminal Top Bar -->
  <div class="px-5 py-3 bg-exo-secondary border-b border-exo-border flex items-center justify-between">
    <div class="flex items-center gap-3">
      <div class="flex items-center gap-1.5">
        <div class="w-2.5 h-2.5 rounded-full bg-red-500/80"></div>
        <div class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></div>
        <div class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></div>
      </div>
      <span class="font-mono text-xs font-semibold text-slate-300 tracking-wider uppercase">
        {topic}
      </span>
    </div>

    <div class="flex items-center gap-2">
      <span class="text-[10px] font-mono uppercase px-2 py-0.5 rounded bg-exo-primary/10 text-exo-primary border border-exo-primary/20">
        LEVEL: {complexity}
      </span>
    </div>
  </div>

  <!-- Breakdown Body -->
  <div class="p-6 md:p-8">
    <h3 class="text-xl font-bold text-white mb-4 flex items-center gap-2">
      <span class="text-exo-primary font-mono text-base">&gt;</span>
      {title}
    </h3>
    <div class="text-slate-300 text-sm md:text-base leading-relaxed space-y-4 technical-body">
      <slot />
    </div>
  </div>
</div>

<style>
  .technical-body :global(p) {
    margin-bottom: 1rem;
    color: #cbd5e1;
  }
  .technical-body :global(strong) {
    color: #f8fafc;
  }
</style>
