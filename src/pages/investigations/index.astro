---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryBadge from '../../components/CategoryBadge.astro';
import { getCollection } from 'astro:content';
import { url, formatDate } from '../../utils/base';

const allInvestigations = await getCollection('investigations');
const published = allInvestigations
  .filter((i) => i.data.status === 'published')
  .sort((a, b) => new Date(b.data.publication_date).getTime() - new Date(a.data.publication_date).getTime());

const allAuthors = await getCollection('authors');

// Extract unique categories, authors, and years
const categories = Array.from(new Set(published.map((i) => i.data.category)));
const authorsList = Array.from(new Set(published.flatMap((i) => i.data.authors)));
const years = Array.from(new Set(published.map((i) => new Date(i.data.publication_date).getFullYear().toString()))).sort().reverse();

const searchItems = published.map((item) => ({
  title: item.data.title,
  slug: item.id.replace(/\.(md|mdx)$/, ''),
  description: item.data.description,
  category: item.data.category,
  caseId: item.data.case_id,
  tags: item.data.tags
}));
---

<BaseLayout
  title="Case Files & Investigations Archive | CYBER EXORCIST"
  description="Explore the complete repository of Cyber Exorcist investigations into cybercrime syndicates, malware operations, darknet markets, and digital forensics."
  searchItems={searchItems}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16">
    <!-- Header -->
    <div class="pb-8 mb-8 border-b border-exo-border">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-exo-secondary border border-exo-border text-xs font-mono text-exo-primary mb-3">
        <span class="w-2 h-2 rounded-full bg-exo-primary"></span>
        REPOSITORY_ARCHIVE // CASE_FILES
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight uppercase">
        Case Files &amp; Investigations
      </h1>
      <p class="text-slate-300 text-sm md:text-base mt-2 max-w-3xl leading-relaxed">
        A permanent archive of deconstructed cybercrime incidents, attack vectors, threat actor timelines, and digital forensic evidence.
      </p>
    </div>

    <!-- Interactive Filter & Search Control Panel -->
    <div class="p-6 rounded-xl bg-exo-secondary border border-exo-border mb-10 space-y-4">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-center">
        <!-- Live Search Field -->
        <div class="md:col-span-5 relative">
          <svg class="w-4 h-4 text-exo-primary absolute left-3.5 top-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
          <input
            type="search"
            id="archive-search"
            placeholder="Search by case title, actor, or exploit vector..."
            class="w-full pl-10 pr-4 py-2.5 rounded-lg bg-exo-bg border border-exo-border text-slate-200 placeholder-slate-400 font-mono text-xs focus:outline-none focus:border-exo-primary"
          />
        </div>

        <!-- Filter Selects -->
        <div class="md:col-span-7 flex flex-wrap gap-2.5">
          <!-- Category Filter -->
          <select
            id="filter-category"
            class="px-3 py-2.5 rounded-lg bg-exo-bg border border-exo-border text-slate-300 font-mono text-xs focus:outline-none focus:border-exo-primary flex-1 min-w-[140px]"
          >
            <option value="all">All Categories</option>
            {categories.map((c) => (
              <option value={c}>{c}</option>
            ))}
          </select>

          <!-- Author Filter -->
          <select
            id="filter-author"
            class="px-3 py-2.5 rounded-lg bg-exo-bg border border-exo-border text-slate-300 font-mono text-xs focus:outline-none focus:border-exo-primary min-w-[120px]"
          >
            <option value="all">All Authors</option>
            {authorsList.map((a) => (
              <option value={a}>{a}</option>
            ))}
          </select>

          <!-- Year Filter -->
          <select
            id="filter-year"
            class="px-3 py-2.5 rounded-lg bg-exo-bg border border-exo-border text-slate-300 font-mono text-xs focus:outline-none focus:border-exo-primary min-w-[100px]"
          >
            <option value="all">All Years</option>
            {years.map((y) => (
              <option value={y}>{y}</option>
            ))}
          </select>

          <!-- Sort Order -->
          <select
            id="sort-order"
            class="px-3 py-2.5 rounded-lg bg-exo-bg border border-exo-border text-slate-300 font-mono text-xs focus:outline-none focus:border-exo-primary min-w-[120px]"
          >
            <option value="newest">Newest First</option>
            <option value="oldest">Oldest First</option>
          </select>
        </div>
      </div>

      <!-- Quick Category Pills -->
      <div class="pt-2 flex flex-wrap items-center gap-2 border-t border-exo-border/60">
        <span class="text-[11px] font-mono text-slate-400 mr-1">SECTOR FILTER:</span>
        <button
          type="button"
          class="category-pill active text-[11px] font-mono px-2.5 py-1 rounded border transition-colors bg-exo-primary text-slate-950 font-bold border-exo-primary"
          data-category="all"
        >
          All Sectors
        </button>
        {categories.map((c) => (
          <button
            type="button"
            class="category-pill text-[11px] font-mono px-2.5 py-1 rounded border transition-colors bg-exo-card text-slate-300 border-exo-border hover:border-exo-primary/60"
            data-category={c}
          >
            {c}
          </button>
        ))}
      </div>
    </div>

    <!-- Active Filter Status Bar -->
    <div class="flex items-center justify-between pb-4 mb-6 font-mono text-xs text-slate-400">
      <div>
        SHOWING: <span id="visible-count" class="text-exo-primary font-bold">{published.length}</span> OF {published.length} DOSSIERS
      </div>
      <button
        type="button"
        id="reset-filters-btn"
        class="hidden text-slate-300 hover:text-exo-primary underline"
      >
        Clear all filters
      </button>
    </div>

    <!-- Grid Container -->
    <div id="investigations-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {published.map((item) => {
        const itemSlug = item.id.replace(/\.(md|mdx)$/, '');
        const itemDate = new Date(item.data.publication_date);
        return (
          <div
            class="investigation-item"
            data-title={item.data.title.toLowerCase()}
            data-description={item.data.description.toLowerCase()}
            data-category={item.data.category}
            data-authors={item.data.authors.join(',')}
            data-year={itemDate.getFullYear().toString()}
            data-timestamp={itemDate.getTime()}
          >
            <article class="group relative flex flex-col h-full rounded-lg bg-exo-card border border-exo-border hover:border-exo-primary/60 transition-all duration-300 overflow-hidden shadow-lg">
              <!-- Thumbnail -->
              <div class="relative h-52 w-full overflow-hidden bg-exo-secondary">
                <a href={url(`/investigations/${itemSlug}`)} class="block w-full h-full">
                  <img
                    src={url(item.data.cover_image)}
                    alt={item.data.title}
                    loading="lazy"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-90 group-hover:opacity-100"
                  />
                </a>

                <div class="absolute top-3 left-3 flex flex-wrap items-center gap-2">
                  <CategoryBadge category={item.data.category} size="sm" />
                  {item.data.case_id && (
                    <span class="font-mono text-[10px] font-bold px-2 py-0.5 rounded bg-black/70 border border-slate-700 text-slate-300 backdrop-blur-sm">
                      {item.data.case_id}
                    </span>
                  )}
                </div>

                {item.data.type === 'technical' && (
                  <div class="absolute top-3 right-3 font-mono text-[10px] uppercase font-bold px-2 py-0.5 rounded bg-purple-950/80 border border-purple-500/50 text-purple-300 backdrop-blur-sm">
                    TECHNICAL DEEP DIVE
                  </div>
                )}
              </div>

              <!-- Body -->
              <div class="p-5 flex flex-col justify-between flex-1">
                <div>
                  <div class="flex items-center gap-3 text-xs font-mono text-exo-muted mb-2">
                    <time datetime={itemDate.toISOString()}>
                      {formatDate(item.data.publication_date)}
                    </time>
                    <span>•</span>
                    <span>{item.data.reading_time}</span>
                  </div>

                  <h2 class="text-lg font-bold text-white group-hover:text-exo-primary transition-colors leading-snug mb-3">
                    <a href={url(`/investigations/${itemSlug}`)}>
                      {item.data.title}
                    </a>
                  </h2>

                  <p class="text-slate-300 text-sm leading-relaxed mb-4 line-clamp-3">
                    {item.data.description}
                  </p>
                </div>

                <!-- Footer -->
                <div class="pt-4 border-t border-exo-border/70 flex items-center justify-between text-xs font-mono">
                  <div class="text-slate-300 truncate max-w-[150px]">
                    <span class="text-exo-muted">BY:</span> {item.data.authors.join(' & ')}
                  </div>

                  <a
                    href={url(`/investigations/${itemSlug}`)}
                    class="inline-flex items-center gap-1 text-exo-primary font-semibold hover:translate-x-0.5 transition-transform flex-shrink-0"
                  >
                    <span>OPEN DOSSIER</span>
                    <span>&rarr;</span>
                  </a>
                </div>
              </div>
            </article>
          </div>
        );
      })}
    </div>

    <!-- Empty State Fallback -->
    <div id="no-results" class="hidden my-16 p-12 text-center rounded-xl bg-exo-secondary border border-exo-border">
      <div class="w-12 h-12 rounded-full bg-exo-card border border-exo-border flex items-center justify-center mx-auto mb-4 text-exo-primary">
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8" />
          <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
      </div>
      <h3 class="text-lg font-bold text-white mb-2">No Matching Case Files Located</h3>
      <p class="text-sm text-slate-400 max-w-md mx-auto mb-6">
        No publications match your current combination of query, sector, author, or year filters.
      </p>
      <button
        type="button"
        id="empty-reset-btn"
        class="px-4 py-2 rounded-lg bg-exo-primary text-slate-950 font-mono text-xs font-bold"
      >
        Reset All Filters
      </button>
    </div>
  </div>

  <script>
    const searchInput = document.getElementById('archive-search') as HTMLInputElement;
    const categorySelect = document.getElementById('filter-category') as HTMLSelectElement;
    const authorSelect = document.getElementById('filter-author') as HTMLSelectElement;
    const yearSelect = document.getElementById('filter-year') as HTMLSelectElement;
    const sortSelect = document.getElementById('sort-order') as HTMLSelectElement;
    const categoryPills = document.querySelectorAll('.category-pill');
    const items = Array.from(document.querySelectorAll<HTMLElement>('.investigation-item'));
    const container = document.getElementById('investigations-grid');
    const visibleCount = document.getElementById('visible-count');
    const noResults = document.getElementById('no-results');
    const resetBtn = document.getElementById('reset-filters-btn');
    const emptyResetBtn = document.getElementById('empty-reset-btn');

    // Read URL query params on load (e.g. ?category=Cryptocurrency+Crimes)
    const urlParams = new URLSearchParams(window.location.search);
    const initialCategory = urlParams.get('category');
    if (initialCategory) {
      if (categorySelect) categorySelect.value = initialCategory;
      categoryPills.forEach((p) => {
        if (p.getAttribute('data-category') === initialCategory) {
          p.classList.add('bg-exo-primary', 'text-slate-950', 'font-bold', 'border-exo-primary');
          p.classList.remove('bg-exo-card', 'text-slate-300');
        } else {
          p.classList.remove('bg-exo-primary', 'text-slate-950', 'font-bold', 'border-exo-primary');
          p.classList.add('bg-exo-card', 'text-slate-300');
        }
      });
    }

    function applyFilters() {
      const query = (searchInput?.value || '').toLowerCase().trim();
      const selectedCategory = categorySelect?.value || 'all';
      const selectedAuthor = authorSelect?.value || 'all';
      const selectedYear = yearSelect?.value || 'all';
      const sortOrder = sortSelect?.value || 'newest';

      let visible = 0;

      items.forEach((item) => {
        const title = item.getAttribute('data-title') || '';
        const desc = item.getAttribute('data-description') || '';
        const cat = item.getAttribute('data-category') || '';
        const authors = item.getAttribute('data-authors') || '';
        const year = item.getAttribute('data-year') || '';

        const matchesQuery = !query || title.includes(query) || desc.includes(query);
        const matchesCategory = selectedCategory === 'all' || cat === selectedCategory;
        const matchesAuthor = selectedAuthor === 'all' || authors.includes(selectedAuthor);
        const matchesYear = selectedYear === 'all' || year === selectedYear;

        if (matchesQuery && matchesCategory && matchesAuthor && matchesYear) {
          item.style.display = '';
          visible++;
        } else {
          item.style.display = 'none';
        }
      });

      // Sort items
      const sortedItems = [...items].sort((a, b) => {
        const timeA = Number(a.getAttribute('data-timestamp') || 0);
        const timeB = Number(b.getAttribute('data-timestamp') || 0);
        return sortOrder === 'newest' ? timeB - timeA : timeA - timeB;
      });

      sortedItems.forEach((it) => container?.appendChild(it));

      if (visibleCount) visibleCount.textContent = String(visible);

      const hasFiltersActive = query || selectedCategory !== 'all' || selectedAuthor !== 'all' || selectedYear !== 'all';
      if (resetBtn) {
        if (hasFiltersActive) resetBtn.classList.remove('hidden');
        else resetBtn.classList.add('hidden');
      }

      if (visible === 0) {
        noResults?.classList.remove('hidden');
        container?.classList.add('hidden');
      } else {
        noResults?.classList.add('hidden');
        container?.classList.remove('hidden');
      }
    }

    // Event listeners
    searchInput?.addEventListener('input', applyFilters);
    categorySelect?.addEventListener('change', () => {
      // Sync pills
      const val = categorySelect.value;
      categoryPills.forEach((p) => {
        if (p.getAttribute('data-category') === val) {
          p.classList.add('bg-exo-primary', 'text-slate-950', 'font-bold', 'border-exo-primary');
          p.classList.remove('bg-exo-card', 'text-slate-300');
        } else {
          p.classList.remove('bg-exo-primary', 'text-slate-950', 'font-bold', 'border-exo-primary');
          p.classList.add('bg-exo-card', 'text-slate-300');
        }
      });
      applyFilters();
    });

    authorSelect?.addEventListener('change', applyFilters);
    yearSelect?.addEventListener('change', applyFilters);
    sortSelect?.addEventListener('change', applyFilters);

    categoryPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const cat = pill.getAttribute('data-category') || 'all';
        if (categorySelect) categorySelect.value = cat;
        categoryPills.forEach((p) => {
          p.classList.remove('bg-exo-primary', 'text-slate-950', 'font-bold', 'border-exo-primary');
          p.classList.add('bg-exo-card', 'text-slate-300');
        });
        pill.classList.add('bg-exo-primary', 'text-slate-950', 'font-bold', 'border-exo-primary');
        pill.classList.remove('bg-exo-card', 'text-slate-300');
        applyFilters();
      });
    });

    function resetAll() {
      if (searchInput) searchInput.value = '';
      if (categorySelect) categorySelect.value = 'all';
      if (authorSelect) authorSelect.value = 'all';
      if (yearSelect) yearSelect.value = 'all';
      if (sortSelect) sortSelect.value = 'newest';
      categoryPills.forEach((p) => {
        if (p.getAttribute('data-category') === 'all') {
          p.classList.add('bg-exo-primary', 'text-slate-950', 'font-bold', 'border-exo-primary');
          p.classList.remove('bg-exo-card', 'text-slate-300');
        } else {
          p.classList.remove('bg-exo-primary', 'text-slate-950', 'font-bold', 'border-exo-primary');
          p.classList.add('bg-exo-card', 'text-slate-300');
        }
      });
      applyFilters();
    }

    resetBtn?.addEventListener('click', resetAll);
    emptyResetBtn?.addEventListener('click', resetAll);

    // Initial run
    applyFilters();
  </script>
</BaseLayout>
