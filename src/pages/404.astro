---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../utils/base';
---

<BaseLayout
  title="Case File Not Found (404) | CYBER EXORCIST"
  description="The requested investigation dossier or forensic record could not be found."
>
  <div class="max-w-3xl mx-auto px-4 py-24 text-center space-y-6">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-exo-secondary border border-exo-border text-xs font-mono text-exo-warning">
      <span class="w-2 h-2 rounded-full bg-exo-warning animate-ping"></span>
      ERROR_STATUS: 404 // NON_EXISTENT_RECORD
    </div>

    <h1 class="text-6xl md:text-8xl font-black text-white font-mono tracking-wider">
      404
    </h1>

    <h2 class="text-xl md:text-2xl font-bold text-white">
      Case File Missing or Redacted
    </h2>

    <p class="text-slate-400 text-sm md:text-base max-w-md mx-auto leading-relaxed">
      The requested cybercrime dossier, technical report, or resource path does not exist in the active publication index.
    </p>

    <div class="pt-4 flex justify-center gap-4">
      <a
        href={url('/')}
        class="px-5 py-2.5 rounded-lg bg-exo-primary text-slate-950 font-mono text-xs font-bold hover:bg-sky-400 transition-colors"
      >
        Return to Headquarters
      </a>
      <a
        href={url('/investigations')}
        class="px-5 py-2.5 rounded-lg bg-exo-secondary border border-exo-border text-slate-200 font-mono text-xs hover:text-white transition-colors"
      >
        Browse Case Files
      </a>
    </div>
  </div>
</BaseLayout>
