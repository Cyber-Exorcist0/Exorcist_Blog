---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InvestigationCard from '../../components/InvestigationCard.astro';
import { getCollection } from 'astro:content';
import { url } from '../../utils/base';

export async function getStaticPaths() {
  const authors = await getCollection('authors');
  return authors.map((author) => ({
    params: { id: author.data.id },
    props: { author: author.data }
  }));
}

const { author } = Astro.props;

const allInvestigations = await getCollection('investigations');
// Find articles by author ID or author name
const authorArticles = allInvestigations.filter(
  (inv) => inv.data.authors.includes(author.name) || inv.data.authors.includes(author.id)
);

const searchItems = allInvestigations.map((item) => ({
  title: item.data.title,
  slug: item.id.replace(/\.(md|mdx)$/, ''),
  description: item.data.description,
  category: item.data.category,
  caseId: item.data.case_id,
  tags: item.data.tags
}));
---

<BaseLayout
  title={`${author.name} | Contributor Profile | CYBER EXORCIST`}
  description={author.bio}
  searchItems={searchItems}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 font-mono text-xs text-exo-muted mb-8" aria-label="Breadcrumb">
      <a href={url('/')} class="hover:text-exo-primary">HOME</a>
      <span>/</span>
      <span class="text-slate-400">CONTRIBUTORS</span>
      <span>/</span>
      <span class="text-slate-200">{author.name}</span>
    </nav>

    <!-- Author Dossier Profile Header -->
    <div class="p-8 md:p-10 rounded-xl bg-exo-secondary border border-exo-border mb-12">
      <div class="flex flex-col md:flex-row items-start gap-8">
        <img
          src={url(author.avatar)}
          alt={author.name}
          class="w-28 h-28 md:w-36 md:h-36 rounded-xl border-2 border-exo-border bg-exo-card flex-shrink-0"
        />

        <div class="space-y-4 flex-1">
          <div>
            <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded bg-exo-card border border-exo-border text-[11px] font-mono text-exo-primary mb-2">
              <span class="w-1.5 h-1.5 rounded-full bg-exo-primary"></span>
              COMPUTER_ENGINEER // AUTHOR_PROFILE
            </div>
            <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-white">
              {author.name}
            </h1>
            <p class="text-sm font-mono text-exo-primary mt-1">{author.role}</p>
          </div>

          <p class="text-sm sm:text-base text-slate-300 leading-relaxed max-w-3xl">
            {author.bio}
          </p>

          <!-- Areas of Research & Study -->
          <div>
            <span class="text-xs font-mono uppercase tracking-wider text-slate-400 block mb-2 font-semibold">
              Areas of Research &amp; Study:
            </span>
            <div class="flex flex-wrap gap-2">
              {author.areas_of_expertise.map((area: string) => (
                <span class="text-xs font-mono px-3 py-1 rounded bg-exo-card border border-exo-border text-slate-200">
                  {area}
                </span>
              ))}
            </div>
          </div>

          <!-- PGP Key / Verification -->
          {author.pgp_key_fingerprint && (
            <div class="p-3 rounded bg-exo-bg border border-exo-border font-mono text-xs flex flex-wrap items-center justify-between gap-2">
              <span class="text-slate-400">PGP FINGERPRINT:</span>
              <code class="text-exo-primary font-bold">{author.pgp_key_fingerprint}</code>
            </div>
          )}

          <!-- Author Social / Network Profiles -->
          {(author.github || author.linkedin || author.twitter) && (
            <div class="pt-2 flex flex-wrap items-center gap-3 font-mono text-xs">
              {author.github && (
                <a
                  href={author.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-exo-card hover:bg-exo-cardHover border border-exo-border hover:border-exo-primary text-slate-200 hover:text-white transition-colors"
                >
                  <svg class="w-4 h-4 text-exo-primary" viewBox="0 0 24 24" fill="currentColor">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
                  </svg>
                  <span>GitHub Profile</span>
                </a>
              )}
              {author.linkedin && (
                <a
                  href={author.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-exo-card hover:bg-exo-cardHover border border-exo-border hover:border-exo-primary text-slate-200 hover:text-white transition-colors"
                >
                  <svg class="w-4 h-4 text-exo-primary" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z" />
                  </svg>
                  <span>LinkedIn Profile</span>
                </a>
              )}
            </div>
          )}
        </div>
      </div>
    </div>

    <!-- Authored Articles -->
    <section>
      <div class="flex items-center justify-between pb-3 mb-8 border-b border-exo-border">
        <h2 class="text-base font-mono font-bold uppercase text-white m-0">
          Published Case Files ({authorArticles.length})
        </h2>
        <span class="text-xs font-mono text-exo-muted">VERIFIED_CONTRIBUTIONS</span>
      </div>

      {authorArticles.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {authorArticles.map((item) => (
            <InvestigationCard
              title={item.data.title}
              slug={item.id.replace(/\.(md|mdx)$/, '')}
              description={item.data.description}
              category={item.data.category}
              publicationDate={item.data.publication_date}
              readingTime={item.data.reading_time}
              coverImage={item.data.cover_image}
              authors={item.data.authors}
              caseId={item.data.case_id}
              type={item.data.type}
            />
          ))}
        </div>
      ) : (
        <div class="p-8 text-center rounded-xl bg-exo-secondary border border-exo-border text-sm font-mono text-slate-400">
          No case files currently credited to this contributor.
        </div>
      )}
    </section>
  </div>
</BaseLayout>
